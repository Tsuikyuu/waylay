# 本地环境变量配置，由 docker-compose.override.yml 读取。
# 复制为 `.env` 并填入实际值（`.env` 已在 .gitignore 中忽略）。

# 自动登录：设置 QQ 号可在重启时免扫码。
# 留空则优先尝试上次登录记录，若无历史记录则回退至扫码登录。
AUTO_LOGIN_QQ=

# Milky 协议鉴权 Token（可选）
MILKY_TOKEN=

# 宿主机机器人框架写入本地文件的目录（使容器内可解析同路径下的 file:// 资源）。
# 若无需使用，请注释掉 docker-compose.override.yml 中对应的 volumes 挂载项。
BOT_DATA_PATH=/path/to/your/bot/data
